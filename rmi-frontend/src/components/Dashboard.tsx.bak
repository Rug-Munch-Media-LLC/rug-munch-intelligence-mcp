              <h2 className="text-sm font-semibold text-white flex items-center gap-2">
                <Layers className="w-4 h-4 text-purple-400" /> PLATFORM FEATURES
              </h2>
              <span className="text-[10px] text-gray-500">{FEATURES.length} tools</span>
            </div>
            <div className="p-2 max-h-[calc(100vh-220px)] overflow-y-auto thin_scroll">
              {/* Group by category */}
              {Object.entries(
                FEATURES.reduce((acc, f) => {
                  (acc[f.cat] = acc[f.cat] || []).push(f);
                  return acc;
                }, {} as Record<string, typeof FEATURES>)
              ).map(([cat, feats]) => (
                <div key={cat} className="mb-3">
                  <p className="text-[10px] font-semibold text-gray-500 uppercase tracking-wider mb-1.5 px-1">{cat}</p>
                  <div className="grid grid-cols-2 gap-1.5">
                    {feats.map((f) => {
                      const Icon = f.icon;
                      return (
                        <button key={f.id + f.label}
                          onClick={() => go(f.path || f.id)}
                          className={`flex flex-col items-start p-2.5 rounded-lg border transition-all hover:scale-[1.02] active:scale-[0.98] ${CAT_CLR[f.cat] || 'border-gray-500/30 bg-gray-500/5'}`}>
                          <div className="flex items-center gap-1.5 mb-1">
                            <Icon className="w-3.5 h-3.5 text-white/80" />
                            <span className="text-xs font-medium text-white truncate">{f.label}</span>
                          </div>
                          <span className="text-[9px] text-gray-500 leading-tight">{f.desc}</span>
                        </button>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* x402 Tool Categories Quick View */}
          <div className="bg-[#0d0d14] border border-purple-500/20 rounded-xl overflow-hidden">
            <div className="p-3 border-b border-purple-500/20 flex items-center justify-between">
              <h2 className="text-sm font-semibold text-white flex items-center gap-2">
                <Cpu className="w-4 h-4 text-purple-400" /> x402 TOOL CATEGORIES
              </h2>
              <button onClick={() => go('datamarket')} className="text-[10px] text-purple-400 hover:text-purple-300">
                Browse →
              </button>
            </div>
            <div className="p-2">
              {(x402.data?.tools || []).reduce((acc: Record<string, number>, t: any) => {
                acc[t.category] = (acc[t.category] || 0) + 1;
                return acc;
              }, {}) && Object.entries(
                (x402.data?.tools || []).reduce((acc: Record<string, number>, t: any) => {
                  acc[t.category] = (acc[t.category] || 0) + 1;
                  return acc;
                }, {})
              ).sort((a, b) => b[1] - a[1]).map(([cat, cnt]) => (
                <div key={cat} className="flex items-center justify-between p-1.5 bg-white/[0.02] rounded-lg mb-1">
                  <span className="text-[11px] text-gray-300 capitalize">{cat}</span>
                  <span className="text-[10px] font-mono text-purple-300">{cnt}</span>
                </div>
              ))}
              <div className="mt-2 text-center">
                <span className="text-xs text-gray-500">{toolCount} tools across {chainCount} chains</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// ── Sub-components ──

function Ticker({ symbol, price, change, icon, isMcap }: { symbol: string; price?: number; change?: number; icon: string; isMcap?: boolean }) {
  return (
    <div className="bg-[#0d0d14] border border-purple-500/20 rounded-lg p-2.5 flex flex-col items-center">
      <div className="flex items-center gap-1.5 mb-0.5">
        <span className="text-sm">{icon}</span>
        <span className="text-xs font-medium text-white">{symbol}</span>
      </div>
      <span className="text-sm font-bold font-mono text-white">{price ? fmtUSD(price) : '—'}</span>
      <div className="flex items-center gap-0.5">
        {change !== undefined && (change >= 0
          ? <TrendingUp className="w-3 h-3 text-emerald-400" />
          : <TrendingDown className="w-3 h-3 text-rose-400" />)}
        <span className={`text-[10px] font-mono ${change !== undefined && change >= 0 ? 'text-emerald-400' : change !== undefined ? 'text-rose-400' : 'text-gray-600'}`}>
          {fmtPct(change)}
        </span>
      </div>
    </div>
  );
}

function LoadSkeleton({ n = 4 }: { n?: number }) {
  return (
    <div className="space-y-1">
      {Array.from({ length: n }).map((_, i) => (
        <div key={i} className="h-10 bg-white/[0.03] rounded-lg animate-pulse" />
      ))}
    </div>
  );
}