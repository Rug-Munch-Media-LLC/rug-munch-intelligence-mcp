  { id: 'rugmaps', label: 'RugMaps', icon: Map, cat: 'Intelligence', desc: 'Bubble map visualization' },
  { id: 'rugcharts', label: 'RugCharts', icon: BarChart3, cat: 'Intelligence', desc: 'DexScreener charts' },
  { id: 'datamarket', label: 'Data Market', icon: Database, cat: 'Intelligence', desc: 'x402 paid tools catalog' },
  { id: 'datamarket', label: 'Coin Compare', icon: Target, cat: 'Intelligence', desc: 'Cross-token side-by-side', path: 'datamarket' },
  { id: 'trenches', label: 'The Trenches', icon: Crosshair, cat: 'Community', desc: 'Live threat BBS' },
  { id: 'rehab', label: 'Rug Pull Rehab', icon: Shield, cat: 'Community', desc: 'Recovery guidance' },
  { id: 'rundown', label: 'Daily Rundown', icon: Newspaper, cat: 'Community', desc: 'Morning briefing' },
  { id: 'gamification', label: 'Agent Profile', icon: Trophy, cat: 'Community', desc: 'Badges & XP' },
  { id: 'wallets', label: 'My Wallets', icon: Wallet, cat: 'Wallet', desc: 'Portfolio tracking' },
  { id: 'payment-hub', label: 'Monetization Hub', icon: Gem, cat: 'Monetize', desc: 'x402 revenue & tiers' },
  { id: 'tier-checkout', label: 'Upgrade Tier', icon: CreditCard, cat: 'Monetize', desc: 'Alpha / Pro / Elite' },
  { id: 'telegram-dashboard', label: 'Telegram Bot', icon: MessageSquare, cat: 'Community', desc: 'Bot management' },
  { id: 'newsletter-subscribe', label: 'Newsletter', icon: Vote, cat: 'Community', desc: 'Weekly intel digest' },
