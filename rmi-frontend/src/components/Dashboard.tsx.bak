const CAT_CLR: Record<string, string> = {
  Security: 'border-red-500/30 bg-red-500/5',
  Intelligence: 'border-cyan-500/30 bg-cyan-500/5',
  Community: 'border-purple-500/30 bg-purple-500/5',
  Wallet: 'border-green-500/30 bg-green-500/5',
  Monetize: 'border-amber-500/30 bg-amber-500/5',
};

export default function Dashboard() {
