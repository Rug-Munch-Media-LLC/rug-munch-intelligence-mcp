/**
 * RMI COMMAND CENTER — Intelligence-Driven Dashboard
 * Left: Live intel feed (alerts, news, bulletin, whale moves)
 * Center: Market data panels (BTC/ETH/SOL, trending, charts)
 * Right: Feature launch grid (all platform tools, no dupes)
 *
 * API: /api/v1/content/market-overview, /api/v1/markets/trending,
 * /api/v1/whales/top, /api/v1/x402/tools-catalog, /api/v1/rugcharts/trending,
 * /api/v1/content/news, /api/v1/alerts/recent, /api/v1/bulletin/latest,
 * /api/v1/bulletin/alerts, /api/v1/x402/dashboard, /mcp/health
 */
import { useState, useEffect, useCallback } from 'react';
import { useAppStore } from '../store/appStore';
import {
  TrendingUp, TrendingDown, Activity, Zap, Globe, Radio, Shield,
  ChevronRight, BarChart3, AlertTriangle, Cpu, RefreshCw,
  Search, Eye, Brain, Flame, MessageSquare, Newspaper,
  CreditCard, Gem, Trophy, Database, Map, Terminal,
  Crosshair, Fingerprint, Scan, Bug, Radar, Target,
  Wallet, Lock, Vote, Megaphone, Layers,
} from 'lucide-react';

const API_BASE = import.meta.env.VITE_API_URL || '';

function useApiFetch<T>(path: string, def: T, ms = 60000) {
  const [s, set] = useState<{ data: T | null; loading: boolean }>({ data: null, loading: true });
  const go = useCallback(async () => {
    try {
      const r = await fetch(`${API_BASE}/api/v1${path}`);
      if (r.ok) set({ data: await r.json(), loading: false });
      else set(p => ({ data: p.data || def, loading: false }));
    } catch { set(p => ({ data: p.data || def, loading: false })); }
  }, [path]);
  useEffect(() => { go(); const i = setInterval(go, ms); return () => clearInterval(i); }, [go, ms]);
  return s;
}

function useDirectFetch<T>(url: string, def: T, ms = 60000) {
  const [s, set] = useState<{ data: T | null; loading: boolean }>({ data: null, loading: true });
  const go = useCallback(async () => {
    try {
      const r = await fetch(url);
      if (r.ok) set({ data: await r.json(), loading: false });
      else set(p => ({ data: p.data || def, loading: false }));
    } catch { set(p => ({ data: p.data || def, loading: false })); }
  }, [url]);
  useEffect(() => { go(); const i = setInterval(go, ms); return () => clearInterval(i); }, [go, ms]);
  return s;
}

// ── Formatters ──
function fmtUSD(v: number): string {
  if (!v && v !== 0) return '—';
  if (v >= 1e12) return `$${(v / 1e12).toFixed(2)}T`;
  if (v >= 1e9) return `$${(v / 1e9).toFixed(2)}B`;
  if (v >= 1e6) return `$${(v / 1e6).toFixed(2)}M`;
  if (v >= 1e3) return `$${(v / 1e3).toFixed(1)}K`;
  if (v < 0.01 && v > 0) return `$${v.toExponential(1)}`;
  return `$${v.toFixed(2)}`;
}
function fmtPct(v: number | undefined) {
  if (v === undefined || v === null) return '—';
  return `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`;
}
function chainClr(c: string) {
  const m: Record<string, string> = {
    solana: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
    ethereum: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
    base: 'bg-blue-600/20 text-blue-200 border-blue-600/30',
    bsc: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/30',
    arbitrum: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
    optimism: 'bg-red-500/20 text-red-300 border-red-500/30',
    polygon: 'bg-violet-500/20 text-violet-300 border-violet-500/30',
    pulsechain: 'bg-pink-500/20 text-pink-300 border-pink-500/30',
  };
  return m[c?.toLowerCase()] || 'bg-gray-500/20 text-gray-300 border-gray-500/30';
}
function sevClr(s: string) {
  if (s === 'critical') return 'text-red-400 bg-red-500/15';
  if (s === 'high') return 'text-orange-400 bg-orange-500/15';
  if (s === 'medium') return 'text-yellow-400 bg-yellow-500/15';
  return 'text-blue-400 bg-blue-500/15';
}

