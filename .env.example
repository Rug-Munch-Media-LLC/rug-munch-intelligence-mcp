# ═══════════════════════════════════════════════════════════
# RMI Backend — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in values. NEVER commit .env to git.
# Auto-generate from Hermes: python3 /root/backend/generate_env.py
# ═══════════════════════════════════════════════════════════

# ── CORE ──────────────────────────────────────────────────
BOT_TOKEN=                    # Telegram bot token from @BotFather
JWT_SECRET=                   # Random string for JWT signing
RMI_AUTH_TOKEN=               # Internal API auth token
ADMIN_API_KEY=                # Admin API key for protected endpoints
ADMIN_IDS=                    # Comma-separated Telegram user IDs

# ── REDIS ──────────────────────────────────────────────────
REDIS_HOST=rmi-redis
REDIS_PORT=6379
REDIS_PASSWORD=               # Redis password (set in compose)
REDIS_DB=0

# ── BLOCKCHAIN RPCs ────────────────────────────────────────
ETH_RPC_URL=                  # Ethereum RPC (Alchemy/Infura)
BASE_RPC_URL=                 # Base L2 RPC
ARB_RPC_URL=                  # Arbitrum RPC
OPT_RPC=                      # Optimism RPC
BSC_RPC_URL=                  # BSC RPC
POLY_RPC_URL=                 # Polygon RPC
AVAX_RPC_URL=                 # Avalanche RPC
SOLANA_RPC=                   # Solana RPC (Helius recommended)

# ── API KEYS ───────────────────────────────────────────────
COINGECKO_API_KEY=            # CoinGecko Demo/Pro API key
CRYPTOPANIC_API_KEY=          # CryptoPanic API key
HELIUS_API_KEY=               # Helius Solana RPC + webhooks
GOPLUS_API_KEY=KaS6D8Mw70VtRHBH1anXfzDMbGUt4h6U6drHFZM5YEMKexyusEF5  # GoPlus Security API key
MORALIS_API_KEY=              # Moralis multichain API
ETHERSCAN_API_KEY=            # Etherscan API key
BSCSCAN_API_KEY=              # BscScan API key
POLYGONSCAN_API_KEY=          # PolygonScan API key
SNOWTRACE_API_KEY=            # Snowtrace (Avalanche) API key
FTMSCAN_API_KEY=              # FtmScan (Fantom) API key
BASESCAN_KEY=                 # BaseScan API key
SOLSCAN_API_KEY=              # Solscan API key
BIRDEYE_API_KEY=              # Birdeye token data API
DUNE_API_KEY=                 # Dune Analytics API key
GMGN_API_KEY=                 # GMGN token scanner API
ARKHAM_API_KEY=               # Arkham Intelligence API
QUICKNODE_KEY=                # QuickNode RPC access

# ── AI / LLM ───────────────────────────────────────────────
OPENROUTER_API_KEY=           # OpenRouter (multi-model gateway)
NVIDIA_API_KEY=               # NVIDIA NIM API
GROQ_API_KEY=                 # Groq fast inference
TOGETHER_API_KEY=             # Together AI
MISTRAL_API_KEY=              # Mistral AI
GEMINI_API_KEY=               # Google Gemini
DASHSCOPE_API_KEY=            # Alibaba DashScope
KIMI_API_KEY=                 # Moonshot/Kimi
HUGGINGFACE_TOKEN=hf_...  # HuggingFace Hub token (WRITE access needed)
GLITCHTIP_DSN=  # Optional: GlitchTip/Sentry DSN for error tracking (http://rmi-glitchtip:8080)

# ── SUPABASE ───────────────────────────────────────────────
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_ANON_KEY=            # Public anon key
SUPABASE_SERVICE_KEY=         # Service role key (secret!)
SUPABASE_JWT_SECRET=          # JWT secret for Supabase auth

# ── OAUTH ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── CONTENT ────────────────────────────────────────────────
GHOST_URL=http://rmi-ghost:2368
GHOST_CONTENT_API_KEY=        # Ghost CMS Content API key
GHOST_ADMIN_KEY=              # Ghost Admin API key

# ── EMAIL ──────────────────────────────────────────────────
GMAIL_APP_PASSWORD=           # Gmail app password for SMTP

# ── CHANNELS ───────────────────────────────────────────────
CHANNEL_MAIN=                 # Telegram main channel ID
CHANNEL_SCANS=                # Token scan results channel
CHANNEL_NEWS=                 # News channel
CHANNEL_ALERTS=               # Security alerts channel
CHANNEL_ALPHA=                # Alpha/premium channel
CHANNEL_PREMIUM=              # Premium subscribers channel

# ── WEB3 SECURITY ──────────────────────────────────────────
EVM_PRIVATE_KEY=              # EVM wallet private key (for signing)
SVM_PRIVATE_KEY=              # Solana wallet private key
ALERT_WEBHOOK_URL=            # Discord/Slack security alert webhook
SLACK_ALERT_WEBHOOK=          # Slack alert webhook
HEALTH_WEBHOOK_URL=           # Health monitor webhook

# ── x402 PAYMENT FACILITATORS ─────────────────────────────
# Coinbase CDP (Developer Platform)
# Register at https://portal.cdp.coinbase.com/ → API Keys
# Free tier: 1,000 transactions/month, fee-free USDC on Base
CDP_API_KEY_ID=               # Coinbase CDP API Key ID (from portal)
CDP_API_KEY_SECRET=           # Coinbase CDP API Key Secret (from portal)
CDP_API_KEY_NAME=rugmunch-x402-facilitator  # Label in CDP portal
CDP_NETWORK=base-mainnet
# CDP Facilitator: fee-free on Base, supports Polygon, Arbitrum, Solana too
COINBASE_CDP_VERIFY_URL=https://api.developer.coinbase.com/platform/v1/x402/verify
COINBASE_CDP_SETTLE_URL=https://api.developer.coinbase.com/platform/v1/x402/settle

# PayAI (Base + Solana, always available)
PAYAI_VERIFY_URL=https://facilitator.payai.network/verify
PAYAI_SETTLE_URL=https://facilitator.payai.network/settle

# Cloudflare x402 (Base Sepolia + Ethereum fallback)
CLOUDFLARE_X402_URL=https://x402.org/facilitator

# BNB Chain Pieverse
PIEVERSE_API_KEY=             # Pieverse x402 API key
PIEVERSE_VERIFY_URL=https://api.pieverse.xyz/x402/verify
PIEVERSE_SETTLE_URL=https://api.pieverse.xyz/x402/settle

# AsterPay (European EUR/SEPA)
ASTERPAY_API_KEY=             # AsterPay API key
ASTERPAY_API_SECRET=          # AsterPay API secret
ASTERPAY_SEPA_IBAN=           # SEPA IBAN for EUR off-ramp
ASTERPAY_VERIFY_URL=https://api.asterpay.io/x402/verify
ASTERPAY_SETTLE_URL=https://api.asterpay.io/x402/settle

# MERX x402 for TRON
MERX_TRON_API_KEY=            # MERX TRON API key
MERX_TRON_VERIFY_URL=https://api.merx.finance/x402/verify
MERX_TRON_SETTLE_URL=https://api.merx.finance/x402/settle

# Primev FastRPC (fee-free Ethereum)
PRIMEV_RPC_URL=https://mev-commit.primev.xyz
PRIMEV_AGENT_ID=23175         # ERC-8004 registered agent
PRIMEV_API_KEY=               # Primev API key

# Satoshi Facilitator (Bitcoin)
SATOSHI_API_KEY=              # Satoshi API key
SATOSHI_VERIFY_URL=https://api.satoshi-facilitator.com/x402/verify
SATOSHI_SETTLE_URL=https://api.satoshi-facilitator.com/x402/settle
SATOSHI_BTC_SETTLE_URL=https://api.satoshi-facilitator.com/btc/settle

# Self-hosted x402-rs
X402_RS_HOST=localhost
X402_RS_PORT=8090
X402_RS_VERIFY_URL=http://localhost:8090/verify
X402_RS_SETTLE_URL=http://localhost:8090/settle

# EIP-7702 Universal EVM RPCs
EIP7702_BSC_RPC=https://bsc-dataseed.binance.org
EIP7702_POLYGON_RPC=https://polygon-rpc.com
EIP7702_AVAX_RPC=https://api.avax.network/ext/bc/C/rpc
EIP7702_FANTOM_RPC=https://rpc.ftm.tools
EIP7702_GNOSIS_RPC=https://rpc.gnosischain.com
EIP7702_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
EIP7702_OPTIMISM_RPC=https://mainnet.optimism.io
EIP7702_BASE_RPC=https://mainnet.base.org

# Facilitator general settings
FACILITATOR_HEALTH_TTL=60
FACILITATOR_VERIFY_TIMEOUT=15
FACILITATOR_MAX_RETRIES=2

# ── Darkroom Token Deployer ────────────────────────────────────
# EVM chains (Ethereum, Base, BSC)
ETH_DEPLOYER_KEY=                    # Private key for Ethereum deployments
ETH_RPC_URL=https://eth.llamarpc.com
BASE_DEPLOYER_KEY=                   # Private key for Base deployments
BASE_RPC_URL=https://base.llamarpc.com
BSC_DEPLOYER_KEY=                    # Private key for BSC deployments
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Solana
SOLANA_DEPLOYER_KEY=                 # Base58-encoded private key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# TRON
TRON_DEPLOYER_KEY=                   # Hex private key (with or without 0x)
TRON_RPC_URL=https://api.trongrid.io

# Token factory contracts (optional — enables gas-efficient factory deploys)
ETH_TOKEN_FACTORY=
BASE_TOKEN_FACTORY=
BSC_TOKEN_FACTORY=

# ── x402 Wallets ───────────────────────────────────────────────
X402_EVM_PAY_TO=0x1E3AC01d0fdb976179790BDD02823196A92705C9
X402_SOL_PAY_TO=Gix4P9AmwcZRGzr2hCEME5m2QAvY86dBfm8c7e7MpFzv
