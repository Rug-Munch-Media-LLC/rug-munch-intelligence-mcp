{
  "name": "io.github.Rug-Munch-Media-LLC/rug-munch-intelligence-mcp",
  "display_name": "Rug Munch Intelligence",
  "description": "Rug Munch Intelligence MCP: 59 tools for crypto scam detection, rug pull prevention, and intelligence across 7 chains.",
  "version": "2.0.0",
  "homepage": "https://rugmunch.io",
  "repository": "https://github.com/Rug-Munch-Media-LLC/rug-munch-intelligence-mcp",
  "author": {
    "name": "CryptoRugMunch",
    "url": "https://github.com/cryptorugmuncher"
  },
  "license": "Proprietary",
  "categories": [
    "security",
    "finance",
    "blockchain",
    "analytics"
  ],
  "tools": 59,
  "chains": [
    "base",
    "solana",
    "ethereum",
    "bsc",
    "arbitrum",
    "optimism",
    "polygon"
  ],
  "mcp": {
    "protocol": "2024-11-05",
    "transport": "stdio"
  },
  "x402": {
    "discovery_url": "https://rugmunch.io/.well-known/x402",
    "payment_network": "base",
    "payment_token": "USDC"
  },
  "install": {
    "pip": "pip install rug-munch-intelligence-mcp",
    "uvx": "uvx rug-munch-intelligence-mcp",
    "smithery": "npx @smithery/cli install rug-munch-intelligence-mcp"
  },
  "env": {
    "RUG_MUNCH_API_BASE": {
      "description": "API base URL",
      "default": "https://rugmunch.io/api/v1",
      "required": false
    },
    "RUG_MUNCH_API_KEY": {
      "description": "API key for premium access (optional)",
      "required": false
    }
  }
}
